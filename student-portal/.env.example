APP_NAME="ACSES Portal Local"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Accra

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acses_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mailpit/MailHog local SMTP. Never put production SMTP credentials here.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="acses@example.test"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
RUSHPAY_API_KEY=
RUSHPAY_CLIENT_KEY=
RUSHPAY_CLIENT_SECRET=
RUSHPAY_MERCHANT_ID=
SMS_API_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=ACSES
SENTRY_LARAVEL_DSN=
SENTRY_DSN=
